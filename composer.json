{
    "name": "garanaw/sailor",
    "keywords": ["laravel", "docker", "sail", "sailor"],
    "type": "library",
    "autoload": {
        "psr-4": {
            "Garanaw\\Sailor\\": "src/"
        }
    },
    "authors": [
        {
            "role": "Developer",
            "name": "Pablo Villalba",
            "email": "garanaw@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "laravel/sail": "^1.29",
        "illuminate/console": "^9.52.16|^10.0|^11.0",
        "illuminate/contracts": "^9.52.16|^10.0|^11.0",
        "illuminate/support": "^9.52.16|^10.0|^11.0",
        "symfony/console": "^6.0|^7.0",
        "symfony/yaml": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "phpstan/phpstan": "^1.10"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Garanaw\\Sailor\\SailorServiceProvider"
            ]
        }
    }
}
